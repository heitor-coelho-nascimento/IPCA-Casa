# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# VITE_SITE_URL: Domínio público oficial para URLs canônicas, sitemap.xml, robots.txt e OpenGraph.
# Exemplo em produção: "https://ipcacasa.com.br" (sem barra no final). Deixe vazio quando usar apenas a URL de preview.
VITE_SITE_URL=""

# VITE_SITE_WWW_MODE: Estratégia canônica de host ("non-www" ou "www").
VITE_SITE_WWW_MODE="non-www"

# VITE_GOOGLE_SITE_VERIFICATION: Código de verificação de propriedade do Google Search Console.
# Renderizado em <meta name="google-site-verification"> apenas nas páginas públicas quando definido.
VITE_GOOGLE_SITE_VERIFICATION=""

# VITE_GA_MEASUREMENT_ID: ID de medição do Google Analytics 4 (ex: G-XXXXXXXXXX).
# Carregado somente no cliente sem bloqueio quando configurado e respeitando consentimento.
VITE_GA_MEASUREMENT_ID=""

# ALLOWED_ORIGINS: Lista separada por vírgulas de origens extras autorizadas no CORS de /api/*.
# Exemplo: "https://ipcacasa.com.br,https://www.ipcacasa.com.br"
ALLOWED_ORIGINS=""
