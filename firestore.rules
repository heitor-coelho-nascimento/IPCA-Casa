rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Security Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isNonNegativeNumber(val) {
      return (val is int || val is float) && val >= 0 && val <= 10000000000;
    }

    function isBoundedNumber(val, minVal, maxVal) {
      return (val is int || val is float) && val >= minVal && val <= maxVal;
    }

    function isValidDataOrigin(val) {
      return val in ['usuario', 'oficial_ibge', 'demonstrativo', 'estimado', 'simulado', 'cache'];
    }

    function isValidProfileMode(val) {
      return val in ['pessoal', 'negocio', 'estudante'];
    }

    function isValidSurplusFrequency(val) {
      return val in ['quase_sempre', 'as_vezes', 'raramente', 'nunca', 'sem_renda_propria', 'nao_sei'];
    }

    function isStringList(val, maxSize) {
      return val is list && val.size() <= maxSize && (val.size() == 0 || val[0] is string);
    }

    function isNumberList(val, maxSize) {
      return val is list && val.size() <= maxSize && (val.size() == 0 || (val[0] is int || val[0] is float));
    }

    function isBoolList(val, maxSize) {
      return val is list && val.size() <= maxSize && (val.size() == 0 || val[0] is bool);
    }

    function isValidDashboardPreferences(pref) {
      return pref is map &&
        pref.keys().hasAll(['basketSetupChoice', 'compareIncomeVsInflation', 'trackMonthlyBudgetImpact']) &&
        pref.keys().hasOnly(['basketSetupChoice', 'compareIncomeVsInflation', 'trackMonthlyBudgetImpact', 'trackCostDrivers']) &&
        pref.basketSetupChoice in ['demonstracao', 'propria'] &&
        pref.compareIncomeVsInflation is bool &&
        pref.trackMonthlyBudgetImpact is bool &&
        (!('trackCostDrivers' in pref) || pref.trackCostDrivers is bool);
    }

    function isValidQuestionnaireDraftArrays(q) {
      return (!('itemDraftIds' in q) || isStringList(q.itemDraftIds, 60)) &&
        (!('itemDraftNames' in q) || isStringList(q.itemDraftNames, 60)) &&
        (!('itemDraftCategories' in q) || isStringList(q.itemDraftCategories, 60)) &&
        (!('itemDraftUnits' in q) || isStringList(q.itemDraftUnits, 60)) &&
        (!('itemDraftQuantities' in q) || isNumberList(q.itemDraftQuantities, 60)) &&
        (!('itemDraftCurrentPrices' in q) || isNumberList(q.itemDraftCurrentPrices, 60)) &&
        (!('itemDraftOldPrices' in q) || isNumberList(q.itemDraftOldPrices, 60)) &&
        (!('itemDraftSuppliers' in q) || isStringList(q.itemDraftSuppliers, 60)) &&
        (!('itemDraftMajorDrivers' in q) || isBoolList(q.itemDraftMajorDrivers, 60)) &&
        (!('itemDraftSharePercents' in q) || isNumberList(q.itemDraftSharePercents, 60));
    }

    function isValidPessoalQuestionnaire(q) {
      return q is map &&
        q.keys().hasOnly([
          'membersCount', 'contributorsCount', 'dependentsCount', 'primaryIncomeComposition',
          'currentMonthlyIncome', 'unknownCurrentIncome', 'incomeOneYearAgo', 'unknownIncomeOneYearAgo',
          'incomePredictability', 'incomeTrend12M', 'incomeEarnersCount',
          'surplusFrequency', 'reportedMonthlySurplus', 'shortfallBehavior', 'estimatedMonthlyExpenses',
          'selectedExpenseCategories', 'categoryEstimateNames', 'categoryEstimateValues', 'expenseStability',
          'selectedRegularProducts', 'shoppingFrequency', 'knowsOldPrices', 'majorBudgetDrivers',
          'itemDraftIds', 'itemDraftNames', 'itemDraftCategories', 'itemDraftUnits',
          'itemDraftQuantities', 'itemDraftCurrentPrices', 'itemDraftOldPrices',
          'itemDraftSuppliers', 'itemDraftMajorDrivers', 'itemDraftSharePercents',
          'basketSetupChoice', 'compareIncomeVsInflation', 'trackMonthlyBudgetImpact'
        ]) &&
        (!('membersCount' in q) || (q.membersCount is int && q.membersCount >= 1 && q.membersCount <= 50)) &&
        (!('contributorsCount' in q) || (q.contributorsCount is int && q.contributorsCount >= 0 && q.contributorsCount <= 50)) &&
        (!('dependentsCount' in q) || (q.dependentsCount is int && q.dependentsCount >= 0 && q.dependentsCount <= 50)) &&
        (!('primaryIncomeComposition' in q) || isBoundedString(q.primaryIncomeComposition, 0, 120)) &&
        (!('currentMonthlyIncome' in q) || isNonNegativeNumber(q.currentMonthlyIncome)) &&
        (!('unknownCurrentIncome' in q) || q.unknownCurrentIncome is bool) &&
        (!('incomeOneYearAgo' in q) || isNonNegativeNumber(q.incomeOneYearAgo)) &&
        (!('unknownIncomeOneYearAgo' in q) || q.unknownIncomeOneYearAgo is bool) &&
        (!('incomePredictability' in q) || isBoundedString(q.incomePredictability, 0, 120)) &&
        (!('incomeTrend12M' in q) || isBoundedString(q.incomeTrend12M, 0, 120)) &&
        (!('incomeEarnersCount' in q) || (q.incomeEarnersCount is int && q.incomeEarnersCount >= 0 && q.incomeEarnersCount <= 50)) &&
        (!('surplusFrequency' in q) || isValidSurplusFrequency(q.surplusFrequency)) &&
        (!('reportedMonthlySurplus' in q) || isNonNegativeNumber(q.reportedMonthlySurplus)) &&
        (!('shortfallBehavior' in q) || isBoundedString(q.shortfallBehavior, 0, 160)) &&
        (!('estimatedMonthlyExpenses' in q) || isNonNegativeNumber(q.estimatedMonthlyExpenses)) &&
        (!('selectedExpenseCategories' in q) || isStringList(q.selectedExpenseCategories, 40)) &&
        (!('categoryEstimateNames' in q) || isStringList(q.categoryEstimateNames, 40)) &&
        (!('categoryEstimateValues' in q) || isNumberList(q.categoryEstimateValues, 40)) &&
        (!('expenseStability' in q) || isBoundedString(q.expenseStability, 0, 120)) &&
        (!('selectedRegularProducts' in q) || isStringList(q.selectedRegularProducts, 60)) &&
        (!('shoppingFrequency' in q) || isBoundedString(q.shoppingFrequency, 0, 120)) &&
        (!('knowsOldPrices' in q) || isBoundedString(q.knowsOldPrices, 0, 60)) &&
        (!('majorBudgetDrivers' in q) || isStringList(q.majorBudgetDrivers, 60)) &&
        isValidQuestionnaireDraftArrays(q) &&
        (!('basketSetupChoice' in q) || q.basketSetupChoice in ['demonstracao', 'propria']) &&
        (!('compareIncomeVsInflation' in q) || q.compareIncomeVsInflation is bool) &&
        (!('trackMonthlyBudgetImpact' in q) || q.trackMonthlyBudgetImpact is bool);
    }

    function isValidNegocioQuestionnaire(q) {
      return q is map &&
        q.keys().hasOnly([
          'businessName', 'businessSegment', 'businessActivityDescription', 'businessSize',
          'workersCount', 'operatingTenure',
          'currentMonthlyRevenue', 'unknownCurrentRevenue', 'revenueOneYearAgo', 'unknownRevenueOneYearAgo',
          'revenuePattern', 'revenueTrend12M', 'primaryRevenueSource',
          'estimatedMonthlyOperatingSpend', 'surplusFrequency', 'reportedMonthlySurplus', 'shortfallReason',
          'selectedCostCategories', 'categoryEstimateNames', 'categoryEstimateValues',
          'fixedCostCategories', 'variableCostCategories', 'operationalCostsIncreased12M', 'operationalCostIncreaseAmount',
          'knowsOldPrices', 'buysFromSameSuppliers', 'wantsToRegisterSuppliers', 'suppliers', 'purchaseFrequency',
          'itemDraftIds', 'itemDraftNames', 'itemDraftCategories', 'itemDraftUnits',
          'itemDraftQuantities', 'itemDraftCurrentPrices', 'itemDraftOldPrices',
          'itemDraftSuppliers', 'itemDraftMajorDrivers', 'itemDraftSharePercents',
          'basketSetupChoice', 'compareCostsVsRevenue', 'trackCostDrivers'
        ]) &&
        (!('businessName' in q) || isBoundedString(q.businessName, 0, 120)) &&
        (!('businessSegment' in q) || isBoundedString(q.businessSegment, 0, 120)) &&
        (!('businessActivityDescription' in q) || isBoundedString(q.businessActivityDescription, 0, 300)) &&
        (!('businessSize' in q) || isBoundedString(q.businessSize, 0, 120)) &&
        (!('workersCount' in q) || (q.workersCount is int && q.workersCount >= 1 && q.workersCount <= 500)) &&
        (!('operatingTenure' in q) || isBoundedString(q.operatingTenure, 0, 120)) &&
        (!('currentMonthlyRevenue' in q) || isNonNegativeNumber(q.currentMonthlyRevenue)) &&
        (!('unknownCurrentRevenue' in q) || q.unknownCurrentRevenue is bool) &&
        (!('revenueOneYearAgo' in q) || isNonNegativeNumber(q.revenueOneYearAgo)) &&
        (!('unknownRevenueOneYearAgo' in q) || q.unknownRevenueOneYearAgo is bool) &&
        (!('revenuePattern' in q) || isBoundedString(q.revenuePattern, 0, 120)) &&
        (!('revenueTrend12M' in q) || isBoundedString(q.revenueTrend12M, 0, 120)) &&
        (!('primaryRevenueSource' in q) || isBoundedString(q.primaryRevenueSource, 0, 120)) &&
        (!('estimatedMonthlyOperatingSpend' in q) || isNonNegativeNumber(q.estimatedMonthlyOperatingSpend)) &&
        (!('surplusFrequency' in q) || isValidSurplusFrequency(q.surplusFrequency)) &&
        (!('reportedMonthlySurplus' in q) || isNonNegativeNumber(q.reportedMonthlySurplus)) &&
        (!('shortfallReason' in q) || isBoundedString(q.shortfallReason, 0, 160)) &&
        (!('selectedCostCategories' in q) || isStringList(q.selectedCostCategories, 40)) &&
        (!('categoryEstimateNames' in q) || isStringList(q.categoryEstimateNames, 40)) &&
        (!('categoryEstimateValues' in q) || isNumberList(q.categoryEstimateValues, 40)) &&
        (!('fixedCostCategories' in q) || isStringList(q.fixedCostCategories, 40)) &&
        (!('variableCostCategories' in q) || isStringList(q.variableCostCategories, 40)) &&
        (!('operationalCostsIncreased12M' in q) || isBoundedString(q.operationalCostsIncreased12M, 0, 60)) &&
        (!('operationalCostIncreaseAmount' in q) || isBoundedString(q.operationalCostIncreaseAmount, 0, 120)) &&
        (!('knowsOldPrices' in q) || isBoundedString(q.knowsOldPrices, 0, 60)) &&
        (!('buysFromSameSuppliers' in q) || isBoundedString(q.buysFromSameSuppliers, 0, 60)) &&
        (!('wantsToRegisterSuppliers' in q) || q.wantsToRegisterSuppliers is bool) &&
        (!('suppliers' in q) || isStringList(q.suppliers, 40)) &&
        (!('purchaseFrequency' in q) || isBoundedString(q.purchaseFrequency, 0, 120)) &&
        isValidQuestionnaireDraftArrays(q) &&
        (!('basketSetupChoice' in q) || q.basketSetupChoice in ['demonstracao', 'propria']) &&
        (!('compareCostsVsRevenue' in q) || q.compareCostsVsRevenue is bool) &&
        (!('trackCostDrivers' in q) || q.trackCostDrivers is bool);
    }

    function isValidEstudanteQuestionnaire(q) {
      return q is map &&
        q.keys().hasOnly([
          'educationLevel', 'institutionType', 'studyPeriod', 'livingSituation',
          'hasNoOwnIncome', 'currentMonthlyIncome', 'incomeSources', 'incomeOneYearAgo',
          'incomeOneYearAgoStatus', 'incomePattern', 'incomeTrend12M',
          'estimatedMonthlyExpenses', 'surplusFrequency', 'reportedMonthlySurplus',
          'selectedExpenseCategories', 'categoryEstimateNames', 'categoryEstimateValues',
          'directPaidCategories', 'hasRecurringExpenses', 'expensesIncreased12M',
          'selectedConsumptionCategories', 'knowsOldPrices', 'majorBudgetDrivers', 'purchaseFrequency',
          'itemDraftIds', 'itemDraftNames', 'itemDraftCategories', 'itemDraftUnits',
          'itemDraftQuantities', 'itemDraftCurrentPrices', 'itemDraftOldPrices',
          'itemDraftSuppliers', 'itemDraftMajorDrivers', 'itemDraftSharePercents',
          'basketSetupChoice', 'compareIncomeVsInflation', 'trackMonthlyBudgetImpact'
        ]) &&
        (!('educationLevel' in q) || isBoundedString(q.educationLevel, 0, 120)) &&
        (!('institutionType' in q) || isBoundedString(q.institutionType, 0, 120)) &&
        (!('studyPeriod' in q) || isBoundedString(q.studyPeriod, 0, 120)) &&
        (!('livingSituation' in q) || isBoundedString(q.livingSituation, 0, 120)) &&
        (!('hasNoOwnIncome' in q) || q.hasNoOwnIncome is bool) &&
        (!('currentMonthlyIncome' in q) || isNonNegativeNumber(q.currentMonthlyIncome)) &&
        (!('incomeSources' in q) || isStringList(q.incomeSources, 40)) &&
        (!('incomeOneYearAgo' in q) || isNonNegativeNumber(q.incomeOneYearAgo)) &&
        (!('incomeOneYearAgoStatus' in q) || q.incomeOneYearAgoStatus in ['informado', 'nao_sei', 'nao_possuia_renda']) &&
        (!('incomePattern' in q) || isBoundedString(q.incomePattern, 0, 120)) &&
        (!('incomeTrend12M' in q) || isBoundedString(q.incomeTrend12M, 0, 120)) &&
        (!('estimatedMonthlyExpenses' in q) || isNonNegativeNumber(q.estimatedMonthlyExpenses)) &&
        (!('surplusFrequency' in q) || isValidSurplusFrequency(q.surplusFrequency)) &&
        (!('reportedMonthlySurplus' in q) || isNonNegativeNumber(q.reportedMonthlySurplus)) &&
        (!('selectedExpenseCategories' in q) || isStringList(q.selectedExpenseCategories, 40)) &&
        (!('categoryEstimateNames' in q) || isStringList(q.categoryEstimateNames, 40)) &&
        (!('categoryEstimateValues' in q) || isNumberList(q.categoryEstimateValues, 40)) &&
        (!('directPaidCategories' in q) || isStringList(q.directPaidCategories, 40)) &&
        (!('hasRecurringExpenses' in q) || q.hasRecurringExpenses is bool) &&
        (!('expensesIncreased12M' in q) || isBoundedString(q.expensesIncreased12M, 0, 60)) &&
        (!('selectedConsumptionCategories' in q) || isStringList(q.selectedConsumptionCategories, 40)) &&
        (!('knowsOldPrices' in q) || isBoundedString(q.knowsOldPrices, 0, 60)) &&
        (!('majorBudgetDrivers' in q) || isStringList(q.majorBudgetDrivers, 60)) &&
        (!('purchaseFrequency' in q) || isBoundedString(q.purchaseFrequency, 0, 120)) &&
        isValidQuestionnaireDraftArrays(q) &&
        (!('basketSetupChoice' in q) || q.basketSetupChoice in ['demonstracao', 'propria']) &&
        (!('compareIncomeVsInflation' in q) || q.compareIncomeVsInflation is bool) &&
        (!('trackMonthlyBudgetImpact' in q) || q.trackMonthlyBudgetImpact is bool);
    }

    function isValidQuestionnaireData(qd) {
      return qd is map &&
        qd.keys().hasAll(['mode', 'version', 'updatedAt']) &&
        qd.keys().hasOnly(['mode', 'version', 'completedAt', 'updatedAt', 'currentStep', 'pessoal', 'negocio', 'estudante']) &&
        isValidProfileMode(qd.mode) &&
        isBoundedString(qd.version, 1, 40) &&
        (!('completedAt' in qd) || isBoundedString(qd.completedAt, 0, 40)) &&
        isBoundedString(qd.updatedAt, 1, 40) &&
        (!('currentStep' in qd) || (qd.currentStep is int && qd.currentStep >= 1 && qd.currentStep <= 5)) &&
        (!('pessoal' in qd) || isValidPessoalQuestionnaire(qd.pessoal)) &&
        (!('negocio' in qd) || isValidNegocioQuestionnaire(qd.negocio)) &&
        (!('estudante' in qd) || isValidEstudanteQuestionnaire(qd.estudante));
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function profileExists(userId, profileId) {
      return exists(/databases/$(database)/documents/users/$(userId)/profiles/$(profileId));
    }

    function itemExists(userId, itemId) {
      return exists(/databases/$(database)/documents/users/$(userId)/basketItems/$(itemId));
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidUserPublic(data, userId) {
      return data.keys().hasAll([
          'id', 'userId', 'displayName', 'authProvider', 'defaultProfileId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'displayName', 'avatarUrl', 'authProvider', 'defaultProfileId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == userId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isBoundedString(data.displayName, 1, 120) &&
        (!('avatarUrl' in data) || isBoundedString(data.avatarUrl, 0, 1000)) &&
        data.authProvider in ['google', 'password'] &&
        isValidId(data.defaultProfileId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'email', 'createdAt', 'updatedAt']) &&
        data.id == 'account' &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isBoundedString(data.email, 3, 255) &&
        data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFamilyProfile(data, userId, profileId) {
      return data.keys().hasAll([
          'id', 'userId', 'name', 'membersCount', 'referenceRegion', 'currency', 'isDemo', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'name', 'profileMode', 'onboardingStatus', 'onboardingStep',
          'onboardingCompletedAt', 'questionnaireVersion', 'priceAlertThresholdPercent',
          'membersCount', 'referenceRegion', 'currency', 'hasNoOwnIncome',
          'reportedMonthlySurplus', 'surplusFrequency', 'estimatedMonthlyExpenses',
          'suppliers', 'dashboardPreferences', 'questionnaireData', 'isDemo', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == profileId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isBoundedString(data.name, 1, 120) &&
        (!('profileMode' in data) || isValidProfileMode(data.profileMode)) &&
        (!('onboardingStatus' in data) || data.onboardingStatus in ['not_started', 'in_progress', 'completed', 'skipped']) &&
        (!('onboardingStep' in data) || (data.onboardingStep is int && data.onboardingStep >= 1 && data.onboardingStep <= 5)) &&
        (!('onboardingCompletedAt' in data) || isBoundedString(data.onboardingCompletedAt, 0, 40)) &&
        (!('questionnaireVersion' in data) || isBoundedString(data.questionnaireVersion, 0, 40)) &&
        (!('priceAlertThresholdPercent' in data) || isBoundedNumber(data.priceAlertThresholdPercent, 0.1, 500)) &&
        data.membersCount is int &&
        data.membersCount >= 1 &&
        data.membersCount <= 50 &&
        isBoundedString(data.referenceRegion, 1, 120) &&
        isBoundedString(data.currency, 1, 10) &&
        (!('hasNoOwnIncome' in data) || data.hasNoOwnIncome is bool) &&
        (!('reportedMonthlySurplus' in data) || isNonNegativeNumber(data.reportedMonthlySurplus)) &&
        (!('surplusFrequency' in data) || isValidSurplusFrequency(data.surplusFrequency)) &&
        (!('estimatedMonthlyExpenses' in data) || isNonNegativeNumber(data.estimatedMonthlyExpenses)) &&
        (!('suppliers' in data) || isStringList(data.suppliers, 40)) &&
        (!('dashboardPreferences' in data) || isValidDashboardPreferences(data.dashboardPreferences)) &&
        (!('questionnaireData' in data) || isValidQuestionnaireData(data.questionnaireData)) &&
        data.isDemo is bool &&
        data.isDemo == false &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBasketItem(data, userId, itemId) {
      return data.keys().hasAll([
          'id', 'userId', 'profileId', 'name', 'group', 'classification',
          'monthlySpend', 'oldPrice', 'currentPrice', 'oldPriceDate', 'currentPriceDate',
          'unit', 'active', 'isArchived', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'profileId', 'profileMode', 'name', 'description', 'group', 'subcategory', 'classification',
          'monthlySpend', 'oldPrice', 'currentPrice', 'oldPriceDate', 'currentPriceDate',
          'unit', 'quantity', 'baseQuantity', 'packageSize', 'packageUnit',
          'consumptionFrequency', 'frequencyDays', 'expenseNature', 'recurrenceType',
          'accountingType', 'supplierName', 'paidDirectly',
          'comparabilityBroken', 'comparabilityReason', 'dataOrigin',
          'notes', 'active', 'isArchived', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == itemId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isValidId(data.profileId) &&
        (!('profileMode' in data) || isValidProfileMode(data.profileMode)) &&
        isBoundedString(data.name, 1, 200) &&
        (!('description' in data) || isBoundedString(data.description, 0, 500)) &&
        isBoundedString(data.group, 1, 120) &&
        (!('subcategory' in data) || isBoundedString(data.subcategory, 0, 120)) &&
        data.classification in ['Essencial', 'Supérfluo', 'Discricionário', 'Não classificado'] &&
        isNonNegativeNumber(data.monthlySpend) &&
        isNonNegativeNumber(data.oldPrice) &&
        isNonNegativeNumber(data.currentPrice) &&
        isBoundedString(data.oldPriceDate, 0, 32) &&
        isBoundedString(data.currentPriceDate, 0, 32) &&
        isBoundedString(data.unit, 1, 40) &&
        (!('quantity' in data) || isNonNegativeNumber(data.quantity)) &&
        (!('baseQuantity' in data) || isNonNegativeNumber(data.baseQuantity)) &&
        (!('packageSize' in data) || isNonNegativeNumber(data.packageSize)) &&
        (!('packageUnit' in data) || isBoundedString(data.packageUnit, 0, 40)) &&
        (!('consumptionFrequency' in data) || data.consumptionFrequency in ['mensal', 'quinzenal', 'semanal', 'diaria', 'anual', 'personalizada_dias']) &&
        (!('frequencyDays' in data) || isBoundedNumber(data.frequencyDays, 1, 3650)) &&
        (!('expenseNature' in data) || data.expenseNature in ['Fixa', 'Variável']) &&
        (!('recurrenceType' in data) || data.recurrenceType in ['Recorrente', 'Eventual']) &&
        (!('accountingType' in data) || data.accountingType in ['Consumo', 'Amortização de dívida', 'Aplicação financeira', 'Transferência']) &&
        (!('supplierName' in data) || isBoundedString(data.supplierName, 0, 160)) &&
        (!('paidDirectly' in data) || data.paidDirectly is bool) &&
        (!('comparabilityBroken' in data) || data.comparabilityBroken is bool) &&
        (!('comparabilityReason' in data) || isBoundedString(data.comparabilityReason, 0, 250)) &&
        (!('dataOrigin' in data) || isValidDataOrigin(data.dataOrigin)) &&
        (!('notes' in data) || isBoundedString(data.notes, 0, 1000)) &&
        data.active is bool &&
        data.isArchived is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPriceRecord(data, userId, priceId) {
      return data.keys().hasAll(['id', 'userId', 'itemId', 'price', 'referenceDate', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'profileId', 'itemId', 'price', 'referenceDate', 'unit', 'source',
          'origin', 'region', 'supplierName', 'packageSize', 'packageUnit', 'dataOrigin', 'comparabilityBroken',
          'notes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == priceId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        (!('profileId' in data) || isBoundedString(data.profileId, 0, 128)) &&
        isValidId(data.itemId) &&
        isNonNegativeNumber(data.price) &&
        isBoundedString(data.referenceDate, 1, 32) &&
        (!('unit' in data) || isBoundedString(data.unit, 0, 40)) &&
        (!('source' in data) || isBoundedString(data.source, 0, 255)) &&
        (!('origin' in data) || isBoundedString(data.origin, 0, 255)) &&
        (!('region' in data) || isBoundedString(data.region, 0, 120)) &&
        (!('supplierName' in data) || isBoundedString(data.supplierName, 0, 160)) &&
        (!('packageSize' in data) || isNonNegativeNumber(data.packageSize)) &&
        (!('packageUnit' in data) || isBoundedString(data.packageUnit, 0, 40)) &&
        (!('dataOrigin' in data) || isValidDataOrigin(data.dataOrigin)) &&
        (!('comparabilityBroken' in data) || data.comparabilityBroken is bool) &&
        (!('notes' in data) || isBoundedString(data.notes, 0, 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidIncomeRecord(data, userId, incomeId) {
      return data.keys().hasAll(['id', 'userId', 'profileId', 'referenceDate', 'nominalIncome', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'profileId', 'profileMode', 'referenceDate', 'nominalIncome', 'source',
          'incomeRole', 'incomePredictability', 'dataOrigin', 'notes',
          'grossIncome', 'netIncome', 'incomeType', 'debtObligations', 'financialApplications',
          'transfers', 'availableReserve', 'workingDaysPerMonth',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == incomeId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isValidId(data.profileId) &&
        (!('profileMode' in data) || isValidProfileMode(data.profileMode)) &&
        isBoundedString(data.referenceDate, 1, 32) &&
        isNonNegativeNumber(data.nominalIncome) &&
        (!('source' in data) || isBoundedString(data.source, 0, 255)) &&
        (!('incomeRole' in data) || data.incomeRole in ['renda_familiar', 'faturamento_negocio', 'renda_estudantil']) &&
        (!('incomePredictability' in data) || data.incomePredictability in ['fixa', 'variavel', 'sazonal', 'mista', 'sem_renda_propria']) &&
        (!('dataOrigin' in data) || isValidDataOrigin(data.dataOrigin)) &&
        (!('notes' in data) || isBoundedString(data.notes, 0, 500)) &&
        (!('grossIncome' in data) || isNonNegativeNumber(data.grossIncome)) &&
        (!('netIncome' in data) || isNonNegativeNumber(data.netIncome)) &&
        (!('incomeType' in data) || isBoundedString(data.incomeType, 0, 60)) &&
        (!('debtObligations' in data) || isNonNegativeNumber(data.debtObligations)) &&
        (!('financialApplications' in data) || isNonNegativeNumber(data.financialApplications)) &&
        (!('transfers' in data) || isNonNegativeNumber(data.transfers)) &&
        (!('availableReserve' in data) || isNonNegativeNumber(data.availableReserve)) &&
        (!('workingDaysPerMonth' in data) || isBoundedNumber(data.workingDaysPerMonth, 1, 31)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConsumptionGroup(data, userId, groupId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'description', 'color', 'icon', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'name', 'description', 'color', 'icon', 'profileMode', 'nationalWeightIBGE', 'isCustom', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == groupId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isBoundedString(data.name, 1, 120) &&
        isBoundedString(data.description, 0, 300) &&
        isBoundedString(data.color, 1, 32) &&
        isBoundedString(data.icon, 1, 64) &&
        (!('profileMode' in data) || isValidProfileMode(data.profileMode)) &&
        (!('nationalWeightIBGE' in data) || (isNonNegativeNumber(data.nationalWeightIBGE) && data.nationalWeightIBGE <= 100)) &&
        (!('isCustom' in data) || data.isCustom is bool) &&
        (!('active' in data) || data.active is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSavingStrategy(data, userId, strategyId) {
      return data.keys().hasAll([
          'id', 'userId', 'profileId', 'planType', 'title', 'applied', 'monthlySavings', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'profileId', 'planType', 'title', 'description', 'applied', 'status', 'monthlySavings',
          'originalItemId', 'originalItemName', 'originalPrice', 'originalPackageSize', 'originalPackageUnit',
          'substituteName', 'substitutePrice', 'substitutePackageSize', 'substitutePackageUnit', 'monthlyQuantity',
          'qualitativeTradeoff', 'resourceName', 'resourceCategory', 'unit', 'tariffPerUnit',
          'fixedFee', 'extraCharges', 'tariffSource', 'tariffDate', 'tieredTariffNote',
          'currentConsumption', 'targetConsumption', 'currentSpend', 'progressPercent', 'notes',
          'initialCapital', 'monthlyInvestment', 'termMonths', 'nominalAnnualRate', 'expectedAnnualInflation',
          'realAnnualYield', 'projection12Months', 'projection24Months', 'projection36Months',
          'productType', 'compoundingFrequency', 'depositTiming', 'taxMode', 'manualTaxRate',
          'adminFeeAnnual', 'custodyFeeAnnual', 'useLinkedSavings',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == strategyId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isValidId(data.profileId) &&
        data.planType in ['PLAN_A', 'PLAN_B', 'PLAN_C'] &&
        isBoundedString(data.title, 1, 200) &&
        (!('description' in data) || isBoundedString(data.description, 0, 600)) &&
        data.applied is bool &&
        (!('status' in data) || data.status in ['potencial', 'simulada', 'planejada', 'realizada']) &&
        isBoundedNumber(data.monthlySavings, -1000000000, 10000000000) &&
        (!('originalItemId' in data) || isBoundedString(data.originalItemId, 0, 128)) &&
        (!('originalItemName' in data) || isBoundedString(data.originalItemName, 0, 200)) &&
        (!('originalPrice' in data) || isNonNegativeNumber(data.originalPrice)) &&
        (!('originalPackageSize' in data) || isNonNegativeNumber(data.originalPackageSize)) &&
        (!('originalPackageUnit' in data) || isBoundedString(data.originalPackageUnit, 0, 40)) &&
        (!('substituteName' in data) || isBoundedString(data.substituteName, 0, 200)) &&
        (!('substitutePrice' in data) || isNonNegativeNumber(data.substitutePrice)) &&
        (!('substitutePackageSize' in data) || isNonNegativeNumber(data.substitutePackageSize)) &&
        (!('substitutePackageUnit' in data) || isBoundedString(data.substitutePackageUnit, 0, 40)) &&
        (!('monthlyQuantity' in data) || isNonNegativeNumber(data.monthlyQuantity)) &&
        (!('qualitativeTradeoff' in data) || isBoundedString(data.qualitativeTradeoff, 0, 600)) &&
        (!('resourceName' in data) || isBoundedString(data.resourceName, 0, 200)) &&
        (!('resourceCategory' in data) || data.resourceCategory in ['energia', 'agua', 'combustivel', 'gas', 'internet', 'outros']) &&
        (!('unit' in data) || isBoundedString(data.unit, 0, 40)) &&
        (!('tariffPerUnit' in data) || isNonNegativeNumber(data.tariffPerUnit)) &&
        (!('fixedFee' in data) || isNonNegativeNumber(data.fixedFee)) &&
        (!('extraCharges' in data) || isNonNegativeNumber(data.extraCharges)) &&
        (!('tariffSource' in data) || isBoundedString(data.tariffSource, 0, 160)) &&
        (!('tariffDate' in data) || isBoundedString(data.tariffDate, 0, 32)) &&
        (!('tieredTariffNote' in data) || isBoundedString(data.tieredTariffNote, 0, 250)) &&
        (!('currentConsumption' in data) || isNonNegativeNumber(data.currentConsumption)) &&
        (!('targetConsumption' in data) || isNonNegativeNumber(data.targetConsumption)) &&
        (!('currentSpend' in data) || isNonNegativeNumber(data.currentSpend)) &&
        (!('progressPercent' in data) || isBoundedNumber(data.progressPercent, 0, 100)) &&
        (!('notes' in data) || isBoundedString(data.notes, 0, 600)) &&
        (!('initialCapital' in data) || isNonNegativeNumber(data.initialCapital)) &&
        (!('monthlyInvestment' in data) || isNonNegativeNumber(data.monthlyInvestment)) &&
        (!('termMonths' in data) || isBoundedNumber(data.termMonths, 1, 600)) &&
        (!('nominalAnnualRate' in data) || isBoundedNumber(data.nominalAnnualRate, 0, 10000)) &&
        (!('expectedAnnualInflation' in data) || isBoundedNumber(data.expectedAnnualInflation, 0, 10000)) &&
        (!('realAnnualYield' in data) || isBoundedNumber(data.realAnnualYield, -100, 10000)) &&
        (!('projection12Months' in data) || isNonNegativeNumber(data.projection12Months)) &&
        (!('projection24Months' in data) || isNonNegativeNumber(data.projection24Months)) &&
        (!('projection36Months' in data) || isNonNegativeNumber(data.projection36Months)) &&
        (!('productType' in data) || data.productType in ['poupanca', 'cdb', 'tesouro_selic', 'tesouro_prefixado', 'tesouro_ipca', 'fundos', 'outros']) &&
        (!('compoundingFrequency' in data) || data.compoundingFrequency in ['mensal', 'diaria', 'anual']) &&
        (!('depositTiming' in data) || data.depositTiming in ['fim', 'inicio']) &&
        (!('taxMode' in data) || data.taxMode in ['automatica', 'manual', 'isento', 'bruto']) &&
        (!('manualTaxRate' in data) || isBoundedNumber(data.manualTaxRate, 0, 100)) &&
        (!('adminFeeAnnual' in data) || isBoundedNumber(data.adminFeeAnnual, 0, 100)) &&
        (!('custodyFeeAnnual' in data) || isBoundedNumber(data.custodyFeeAnnual, 0, 100)) &&
        (!('useLinkedSavings' in data) || data.useLinkedSavings is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMonthlyClosure(data, userId, closureId) {
      return data.keys().hasAll([
          'id', 'userId', 'profileId', 'monthKey', 'monthLabel',
          'totalMonthlySpend', 'comparableBaseCost', 'ipcaCasaPercent', 'ipcaOficialPercent', 'spreadPP',
          'itemsCount', 'eligibleItemsCount', 'closedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'profileId', 'monthKey', 'monthLabel', 'profileMode',
          'totalMonthlySpend', 'comparableBaseCost', 'ipcaCasaPercent', 'ipcaOficialPercent', 'spreadPP',
          'itemsCount', 'eligibleItemsCount', 'monthlyIncome', 'monthlyBalance',
          'topCategory', 'topDriverName', 'topDriverChangePercent',
          'priceEffectReais', 'quantityEffectReais', 'mixEffectReais',
          'ibgeSourceMode', 'ibgeReferenceMonth', 'dataOrigin', 'notes',
          'closedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == closureId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isValidId(data.profileId) &&
        isBoundedString(data.monthKey, 7, 10) &&
        data.monthKey.matches('^[0-9]{4}-[0-9]{2}$') &&
        isBoundedString(data.monthLabel, 1, 32) &&
        (!('profileMode' in data) || isValidProfileMode(data.profileMode)) &&
        isNonNegativeNumber(data.totalMonthlySpend) &&
        isNonNegativeNumber(data.comparableBaseCost) &&
        isBoundedNumber(data.ipcaCasaPercent, -100, 100000) &&
        isBoundedNumber(data.ipcaOficialPercent, -100, 100000) &&
        isBoundedNumber(data.spreadPP, -100000, 100000) &&
        data.itemsCount is int &&
        data.itemsCount >= 0 &&
        data.itemsCount <= 10000 &&
        data.eligibleItemsCount is int &&
        data.eligibleItemsCount >= 0 &&
        data.eligibleItemsCount <= 10000 &&
        (!('monthlyIncome' in data) || isNonNegativeNumber(data.monthlyIncome)) &&
        (!('monthlyBalance' in data) || isBoundedNumber(data.monthlyBalance, -1000000000, 10000000000)) &&
        (!('topCategory' in data) || isBoundedString(data.topCategory, 0, 120)) &&
        (!('topDriverName' in data) || isBoundedString(data.topDriverName, 0, 200)) &&
        (!('topDriverChangePercent' in data) || isBoundedNumber(data.topDriverChangePercent, -100, 100000)) &&
        (!('priceEffectReais' in data) || isBoundedNumber(data.priceEffectReais, -1000000000, 10000000000)) &&
        (!('quantityEffectReais' in data) || isBoundedNumber(data.quantityEffectReais, -1000000000, 10000000000)) &&
        (!('mixEffectReais' in data) || isBoundedNumber(data.mixEffectReais, -1000000000, 10000000000)) &&
        (!('ibgeSourceMode' in data) || data.ibgeSourceMode in ['live', 'cached_live', 'contingency']) &&
        (!('ibgeReferenceMonth' in data) || isBoundedString(data.ibgeReferenceMonth, 0, 32)) &&
        (!('dataOrigin' in data) || isValidDataOrigin(data.dataOrigin)) &&
        (!('notes' in data) || isBoundedString(data.notes, 0, 500)) &&
        isBoundedString(data.closedAt, 1, 32) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConsentRecord(data, userId, recordId) {
      return data.keys().hasAll([
          'id', 'userId', 'anonymousConsentId', 'essenciais', 'analytics', 'marketing',
          'cmpVersion', 'policyVersion', 'source', 'decidedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'anonymousConsentId', 'essenciais', 'analytics', 'marketing',
          'cmpVersion', 'policyVersion', 'source', 'decidedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == recordId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isValidId(data.anonymousConsentId) &&
        data.essenciais is bool &&
        data.essenciais == true &&
        data.analytics is bool &&
        data.marketing is bool &&
        isBoundedString(data.cmpVersion, 1, 40) &&
        isBoundedString(data.policyVersion, 1, 40) &&
        data.source in ['banner', 'modal', 'privacy_page', 'settings', 'revocation'] &&
        isBoundedString(data.decidedAt, 1, 40) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTermsAcceptance(data, userId, acceptanceId) {
      return data.keys().hasAll([
          'id', 'userId', 'termsVersion', 'policyVersion', 'acceptedTerms',
          'acceptedPrivacy', 'acceptanceMethod', 'acceptedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'termsVersion', 'policyVersion', 'acceptedTerms',
          'acceptedPrivacy', 'acceptanceMethod', 'acceptedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == acceptanceId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isBoundedString(data.termsVersion, 1, 40) &&
        isBoundedString(data.policyVersion, 1, 40) &&
        data.acceptedTerms is bool &&
        data.acceptedTerms == true &&
        data.acceptedPrivacy is bool &&
        data.acceptedPrivacy == true &&
        data.acceptanceMethod in ['email_register', 'google_signin', 'post_login_gate'] &&
        isBoundedString(data.acceptedAt, 1, 40) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPrivacyRequest(data, userId, requestId) {
      return data.keys().hasAll([
          'id', 'userId', 'requestType', 'status', 'details', 'requestedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'requestType', 'status', 'details', 'resolutionNote', 'requestedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == requestId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        data.requestType in [
          'confirmacao_acesso',
          'correcao',
          'anonimizacao_eliminacao',
          'portabilidade',
          'revogacao_consentimento',
          'informacao_compartilhamento',
          'revisao_oposicao'
        ] &&
        data.status in ['registrada', 'em_analise', 'atendida', 'cancelada'] &&
        isBoundedString(data.details, 1, 1000) &&
        (!('resolutionNote' in data) || isBoundedString(data.resolutionNote, 0, 500)) &&
        isBoundedString(data.requestedAt, 1, 40) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserPublic(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserPublic(incoming(), userId) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'avatarUrl', 'authProvider', 'defaultProfileId', 'updatedAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(userId);

      // Isolated PII subcollection
      match /private/{docId} {
        allow get: if isOwner(userId) && docId == 'account' && userExists(userId);
        allow list: if false;
        allow create: if isOwner(userId) &&
          docId == 'account' &&
          isValidUserPrivate(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (userExists(userId) || existsAfter(/databases/$(database)/documents/users/$(userId)));
        allow update: if isOwner(userId) &&
          docId == 'account' &&
          userExists(userId) &&
          isValidUserPrivate(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if isOwner(userId) && docId == 'account' && userExists(userId);
      }

      // Family Profiles
      match /profiles/{profileId} {
        allow get: if isOwner(userId) && isValidId(profileId) && userExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(profileId) &&
          isValidFamilyProfile(incoming(), userId, profileId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (userExists(userId) || existsAfter(/databases/$(database)/documents/users/$(userId)));
        allow update: if isOwner(userId) &&
          isValidId(profileId) &&
          userExists(userId) &&
          isValidFamilyProfile(incoming(), userId, profileId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'profileMode', 'onboardingStatus', 'onboardingStep',
            'onboardingCompletedAt', 'questionnaireVersion', 'priceAlertThresholdPercent',
            'membersCount', 'referenceRegion', 'currency', 'hasNoOwnIncome',
            'reportedMonthlySurplus', 'surplusFrequency', 'estimatedMonthlyExpenses',
            'suppliers', 'dashboardPreferences', 'questionnaireData', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(profileId) && userExists(userId);
      }

      // Basket Items
      match /basketItems/{itemId} {
        allow get: if isOwner(userId) && isValidId(itemId) && userExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(itemId) &&
          isValidBasketItem(incoming(), userId, itemId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId) &&
          profileExists(userId, incoming().profileId);
        allow update: if isOwner(userId) &&
          isValidId(itemId) &&
          userExists(userId) &&
          isValidBasketItem(incoming(), userId, itemId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().profileId == existing().profileId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'profileMode', 'name', 'description', 'group', 'subcategory', 'classification', 'monthlySpend',
            'oldPrice', 'currentPrice', 'oldPriceDate', 'currentPriceDate',
            'unit', 'quantity', 'baseQuantity', 'packageSize', 'packageUnit',
            'consumptionFrequency', 'frequencyDays', 'expenseNature', 'recurrenceType',
            'accountingType', 'supplierName', 'paidDirectly',
            'comparabilityBroken', 'comparabilityReason', 'dataOrigin',
            'notes', 'active', 'isArchived', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(itemId) && userExists(userId);
      }

      // Price History
      match /priceHistory/{priceId} {
        allow get: if isOwner(userId) && isValidId(priceId) && userExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(priceId) &&
          isValidPriceRecord(incoming(), userId, priceId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId) &&
          (itemExists(userId, incoming().itemId) || existsAfter(/databases/$(database)/documents/users/$(userId)/basketItems/$(incoming().itemId)));
        allow update: if isOwner(userId) &&
          isValidId(priceId) &&
          userExists(userId) &&
          isValidPriceRecord(incoming(), userId, priceId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().itemId == existing().itemId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'price', 'referenceDate', 'unit', 'source', 'origin', 'region', 'supplierName',
            'packageSize', 'packageUnit', 'dataOrigin', 'comparabilityBroken', 'notes', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(priceId) && userExists(userId);
      }

      // Income History
      match /incomeHistory/{incomeId} {
        allow get: if isOwner(userId) && isValidId(incomeId) && userExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(incomeId) &&
          isValidIncomeRecord(incoming(), userId, incomeId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId) &&
          profileExists(userId, incoming().profileId);
        allow update: if isOwner(userId) &&
          isValidId(incomeId) &&
          userExists(userId) &&
          isValidIncomeRecord(incoming(), userId, incomeId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().profileId == existing().profileId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'profileMode', 'referenceDate', 'nominalIncome', 'source', 'incomeRole',
            'incomePredictability', 'dataOrigin', 'notes',
            'grossIncome', 'netIncome', 'incomeType', 'debtObligations', 'financialApplications',
            'transfers', 'availableReserve', 'workingDaysPerMonth', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(incomeId) && userExists(userId);
      }

      // Consumption Groups
      match /consumptionGroups/{groupId} {
        allow get: if isOwner(userId) && isValidId(groupId) && userExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(groupId) &&
          isValidConsumptionGroup(incoming(), userId, groupId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId);
        allow update: if isOwner(userId) &&
          isValidId(groupId) &&
          userExists(userId) &&
          isValidConsumptionGroup(incoming(), userId, groupId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'description', 'color', 'icon', 'profileMode', 'nationalWeightIBGE', 'isCustom', 'active', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(groupId) && userExists(userId);
      }

      // Saving Strategies (Plans A, B, C)
      match /strategies/{strategyId} {
        allow get: if isOwner(userId) && isValidId(strategyId) && userExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(strategyId) &&
          isValidSavingStrategy(incoming(), userId, strategyId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId) &&
          profileExists(userId, incoming().profileId);
        allow update: if isOwner(userId) &&
          isValidId(strategyId) &&
          userExists(userId) &&
          isValidSavingStrategy(incoming(), userId, strategyId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().profileId == existing().profileId &&
          incoming().planType == existing().planType &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'applied', 'status', 'monthlySavings',
            'originalItemId', 'originalItemName', 'originalPrice', 'originalPackageSize', 'originalPackageUnit',
            'substituteName', 'substitutePrice', 'substitutePackageSize', 'substitutePackageUnit', 'monthlyQuantity',
            'qualitativeTradeoff', 'resourceName', 'resourceCategory', 'unit', 'tariffPerUnit',
            'fixedFee', 'extraCharges', 'tariffSource', 'tariffDate', 'tieredTariffNote',
            'currentConsumption', 'targetConsumption', 'currentSpend', 'progressPercent', 'notes',
            'initialCapital', 'monthlyInvestment', 'termMonths', 'nominalAnnualRate', 'expectedAnnualInflation',
            'realAnnualYield', 'projection12Months', 'projection24Months', 'projection36Months',
            'productType', 'compoundingFrequency', 'depositTiming', 'taxMode', 'manualTaxRate',
            'adminFeeAnnual', 'custodyFeeAnnual', 'useLinkedSavings', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(strategyId) && userExists(userId);
      }

      // Monthly Closures
      match /monthlyClosures/{closureId} {
        allow get: if isOwner(userId) && isValidId(closureId) && userExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(closureId) &&
          isValidMonthlyClosure(incoming(), userId, closureId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId) &&
          profileExists(userId, incoming().profileId);
        allow update: if isOwner(userId) &&
          isValidId(closureId) &&
          userExists(userId) &&
          isValidMonthlyClosure(incoming(), userId, closureId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().profileId == existing().profileId &&
          incoming().monthKey == existing().monthKey &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'monthLabel', 'profileMode', 'totalMonthlySpend', 'comparableBaseCost',
            'ipcaCasaPercent', 'ipcaOficialPercent', 'spreadPP',
            'itemsCount', 'eligibleItemsCount', 'monthlyIncome', 'monthlyBalance',
            'topCategory', 'topDriverName', 'topDriverChangePercent',
            'priceEffectReais', 'quantityEffectReais', 'mixEffectReais',
            'ibgeSourceMode', 'ibgeReferenceMonth', 'dataOrigin', 'notes', 'closedAt', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(closureId) && userExists(userId);
      }

      // Consent Records (LGPD CMP Audit Trail)
      match /consentRecords/{recordId} {
        allow get: if isOwner(userId) && isValidId(recordId) && userExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(recordId) &&
          isValidConsentRecord(incoming(), userId, recordId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(recordId) && userExists(userId);
      }

      // Terms & Privacy Acceptances (Versioned Evidence)
      match /termsAcceptances/{acceptanceId} {
        allow get: if isOwner(userId) && isValidId(acceptanceId) && userExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(acceptanceId) &&
          isValidTermsAcceptance(incoming(), userId, acceptanceId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(acceptanceId) && userExists(userId);
      }

      // Data Subject Privacy Requests (Art. 18 LGPD)
      match /privacyRequests/{requestId} {
        allow get: if isOwner(userId) && isValidId(requestId) && userExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(requestId) &&
          isValidPrivacyRequest(incoming(), userId, requestId) &&
          incoming().status == 'registrada' &&
          !('resolutionNote' in incoming()) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId);
        allow update: if isOwner(userId) &&
          isValidId(requestId) &&
          userExists(userId) &&
          isValidPrivacyRequest(incoming(), userId, requestId) &&
          existing().status in ['registrada', 'em_analise'] &&
          incoming().status == 'cancelada' &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().requestType == existing().requestType &&
          incoming().details == existing().details &&
          incoming().requestedAt == existing().requestedAt &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(requestId) && userExists(userId);
      }
    }
  }
}
