rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Security Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isNonNegativeNumber(val) {
      return (val is int || val is float) && val >= 0 && val <= 10000000000;
    }

    function isBoundedNumber(val, minVal, maxVal) {
      return (val is int || val is float) && val >= minVal && val <= maxVal;
    }

    function isValidDataOrigin(val) {
      return val in ['usuario', 'oficial_ibge', 'demonstrativo', 'estimado', 'simulado', 'cache'];
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function profileExists(userId, profileId) {
      return exists(/databases/$(database)/documents/users/$(userId)/profiles/$(profileId));
    }

    function itemExists(userId, itemId) {
      return exists(/databases/$(database)/documents/users/$(userId)/basketItems/$(itemId));
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidUserPublic(data, userId) {
      return data.keys().hasAll([
          'id', 'userId', 'displayName', 'authProvider', 'defaultProfileId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'displayName', 'avatarUrl', 'authProvider', 'defaultProfileId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == userId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isBoundedString(data.displayName, 1, 120) &&
        (!('avatarUrl' in data) || isBoundedString(data.avatarUrl, 0, 1000)) &&
        data.authProvider in ['google', 'password'] &&
        isValidId(data.defaultProfileId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'email', 'createdAt', 'updatedAt']) &&
        data.id == 'account' &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isBoundedString(data.email, 3, 255) &&
        data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFamilyProfile(data, userId, profileId) {
      return data.keys().hasAll([
          'id', 'userId', 'name', 'membersCount', 'referenceRegion', 'currency', 'isDemo', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'name', 'membersCount', 'referenceRegion', 'currency', 'isDemo', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == profileId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isBoundedString(data.name, 1, 120) &&
        data.membersCount is int &&
        data.membersCount >= 1 &&
        data.membersCount <= 50 &&
        isBoundedString(data.referenceRegion, 1, 120) &&
        isBoundedString(data.currency, 1, 10) &&
        data.isDemo is bool &&
        data.isDemo == false &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBasketItem(data, userId, itemId) {
      return data.keys().hasAll([
          'id', 'userId', 'profileId', 'name', 'group', 'classification',
          'monthlySpend', 'oldPrice', 'currentPrice', 'oldPriceDate', 'currentPriceDate',
          'unit', 'active', 'isArchived', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'profileId', 'name', 'description', 'group', 'subcategory', 'classification',
          'monthlySpend', 'oldPrice', 'currentPrice', 'oldPriceDate', 'currentPriceDate',
          'unit', 'quantity', 'baseQuantity', 'packageSize', 'packageUnit',
          'consumptionFrequency', 'frequencyDays', 'expenseNature', 'recurrenceType',
          'accountingType', 'comparabilityBroken', 'comparabilityReason', 'dataOrigin',
          'notes', 'active', 'isArchived', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == itemId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isValidId(data.profileId) &&
        isBoundedString(data.name, 1, 200) &&
        (!('description' in data) || isBoundedString(data.description, 0, 500)) &&
        isBoundedString(data.group, 1, 120) &&
        (!('subcategory' in data) || isBoundedString(data.subcategory, 0, 120)) &&
        data.classification in ['Essencial', 'Supérfluo', 'Não classificado'] &&
        isNonNegativeNumber(data.monthlySpend) &&
        isNonNegativeNumber(data.oldPrice) &&
        isNonNegativeNumber(data.currentPrice) &&
        isBoundedString(data.oldPriceDate, 0, 32) &&
        isBoundedString(data.currentPriceDate, 0, 32) &&
        isBoundedString(data.unit, 1, 40) &&
        (!('quantity' in data) || isNonNegativeNumber(data.quantity)) &&
        (!('baseQuantity' in data) || isNonNegativeNumber(data.baseQuantity)) &&
        (!('packageSize' in data) || isNonNegativeNumber(data.packageSize)) &&
        (!('packageUnit' in data) || isBoundedString(data.packageUnit, 0, 40)) &&
        (!('consumptionFrequency' in data) || data.consumptionFrequency in ['mensal', 'quinzenal', 'semanal', 'diaria', 'anual', 'personalizada_dias']) &&
        (!('frequencyDays' in data) || isBoundedNumber(data.frequencyDays, 1, 3650)) &&
        (!('expenseNature' in data) || data.expenseNature in ['Fixa', 'Variável']) &&
        (!('recurrenceType' in data) || data.recurrenceType in ['Recorrente', 'Eventual']) &&
        (!('accountingType' in data) || data.accountingType in ['Consumo', 'Amortização de dívida', 'Aplicação financeira', 'Transferência']) &&
        (!('comparabilityBroken' in data) || data.comparabilityBroken is bool) &&
        (!('comparabilityReason' in data) || isBoundedString(data.comparabilityReason, 0, 250)) &&
        (!('dataOrigin' in data) || isValidDataOrigin(data.dataOrigin)) &&
        (!('notes' in data) || isBoundedString(data.notes, 0, 1000)) &&
        data.active is bool &&
        data.isArchived is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPriceRecord(data, userId, priceId) {
      return data.keys().hasAll(['id', 'userId', 'itemId', 'price', 'referenceDate', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'profileId', 'itemId', 'price', 'referenceDate', 'unit', 'source',
          'origin', 'region', 'packageSize', 'packageUnit', 'dataOrigin', 'comparabilityBroken',
          'notes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == priceId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        (!('profileId' in data) || isBoundedString(data.profileId, 0, 128)) &&
        isValidId(data.itemId) &&
        isNonNegativeNumber(data.price) &&
        isBoundedString(data.referenceDate, 1, 32) &&
        (!('unit' in data) || isBoundedString(data.unit, 0, 40)) &&
        (!('source' in data) || isBoundedString(data.source, 0, 255)) &&
        (!('origin' in data) || isBoundedString(data.origin, 0, 255)) &&
        (!('region' in data) || isBoundedString(data.region, 0, 120)) &&
        (!('packageSize' in data) || isNonNegativeNumber(data.packageSize)) &&
        (!('packageUnit' in data) || isBoundedString(data.packageUnit, 0, 40)) &&
        (!('dataOrigin' in data) || isValidDataOrigin(data.dataOrigin)) &&
        (!('comparabilityBroken' in data) || data.comparabilityBroken is bool) &&
        (!('notes' in data) || isBoundedString(data.notes, 0, 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidIncomeRecord(data, userId, incomeId) {
      return data.keys().hasAll(['id', 'userId', 'profileId', 'referenceDate', 'nominalIncome', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'profileId', 'referenceDate', 'nominalIncome', 'source', 'notes',
          'grossIncome', 'netIncome', 'incomeType', 'debtObligations', 'financialApplications',
          'transfers', 'availableReserve', 'workingDaysPerMonth',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == incomeId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isValidId(data.profileId) &&
        isBoundedString(data.referenceDate, 1, 32) &&
        isNonNegativeNumber(data.nominalIncome) &&
        (!('source' in data) || isBoundedString(data.source, 0, 255)) &&
        (!('notes' in data) || isBoundedString(data.notes, 0, 500)) &&
        (!('grossIncome' in data) || isNonNegativeNumber(data.grossIncome)) &&
        (!('netIncome' in data) || isNonNegativeNumber(data.netIncome)) &&
        (!('incomeType' in data) || isBoundedString(data.incomeType, 0, 60)) &&
        (!('debtObligations' in data) || isNonNegativeNumber(data.debtObligations)) &&
        (!('financialApplications' in data) || isNonNegativeNumber(data.financialApplications)) &&
        (!('transfers' in data) || isNonNegativeNumber(data.transfers)) &&
        (!('availableReserve' in data) || isNonNegativeNumber(data.availableReserve)) &&
        (!('workingDaysPerMonth' in data) || isBoundedNumber(data.workingDaysPerMonth, 1, 31)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConsumptionGroup(data, userId, groupId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'description', 'color', 'icon', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'name', 'description', 'color', 'icon', 'nationalWeightIBGE', 'isCustom', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == groupId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isBoundedString(data.name, 1, 120) &&
        isBoundedString(data.description, 0, 300) &&
        isBoundedString(data.color, 1, 32) &&
        isBoundedString(data.icon, 1, 64) &&
        (!('nationalWeightIBGE' in data) || (isNonNegativeNumber(data.nationalWeightIBGE) && data.nationalWeightIBGE <= 100)) &&
        (!('isCustom' in data) || data.isCustom is bool) &&
        (!('active' in data) || data.active is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSavingStrategy(data, userId, strategyId) {
      return data.keys().hasAll([
          'id', 'userId', 'profileId', 'planType', 'title', 'applied', 'monthlySavings', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'profileId', 'planType', 'title', 'description', 'applied', 'status', 'monthlySavings',
          'originalItemId', 'originalItemName', 'originalPrice', 'originalPackageSize', 'originalPackageUnit',
          'substituteName', 'substitutePrice', 'substitutePackageSize', 'substitutePackageUnit', 'monthlyQuantity',
          'qualitativeTradeoff', 'resourceName', 'resourceCategory', 'unit', 'tariffPerUnit',
          'fixedFee', 'extraCharges', 'tariffSource', 'tariffDate', 'tieredTariffNote',
          'currentConsumption', 'targetConsumption', 'currentSpend', 'progressPercent', 'notes',
          'initialCapital', 'monthlyInvestment', 'termMonths', 'nominalAnnualRate', 'expectedAnnualInflation',
          'realAnnualYield', 'projection12Months', 'projection24Months', 'projection36Months',
          'productType', 'compoundingFrequency', 'depositTiming', 'taxMode', 'manualTaxRate',
          'adminFeeAnnual', 'custodyFeeAnnual', 'useLinkedSavings',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == strategyId &&
        data.userId == request.auth.uid &&
        data.userId == userId &&
        isValidId(data.profileId) &&
        data.planType in ['PLAN_A', 'PLAN_B', 'PLAN_C'] &&
        isBoundedString(data.title, 1, 200) &&
        (!('description' in data) || isBoundedString(data.description, 0, 600)) &&
        data.applied is bool &&
        (!('status' in data) || data.status in ['potencial', 'simulada', 'planejada', 'realizada']) &&
        isBoundedNumber(data.monthlySavings, -1000000000, 10000000000) &&
        (!('originalItemId' in data) || isBoundedString(data.originalItemId, 0, 128)) &&
        (!('originalItemName' in data) || isBoundedString(data.originalItemName, 0, 200)) &&
        (!('originalPrice' in data) || isNonNegativeNumber(data.originalPrice)) &&
        (!('originalPackageSize' in data) || isNonNegativeNumber(data.originalPackageSize)) &&
        (!('originalPackageUnit' in data) || isBoundedString(data.originalPackageUnit, 0, 40)) &&
        (!('substituteName' in data) || isBoundedString(data.substituteName, 0, 200)) &&
        (!('substitutePrice' in data) || isNonNegativeNumber(data.substitutePrice)) &&
        (!('substitutePackageSize' in data) || isNonNegativeNumber(data.substitutePackageSize)) &&
        (!('substitutePackageUnit' in data) || isBoundedString(data.substitutePackageUnit, 0, 40)) &&
        (!('monthlyQuantity' in data) || isNonNegativeNumber(data.monthlyQuantity)) &&
        (!('qualitativeTradeoff' in data) || isBoundedString(data.qualitativeTradeoff, 0, 600)) &&
        (!('resourceName' in data) || isBoundedString(data.resourceName, 0, 200)) &&
        (!('resourceCategory' in data) || data.resourceCategory in ['energia', 'agua', 'combustivel', 'gas', 'internet', 'outros']) &&
        (!('unit' in data) || isBoundedString(data.unit, 0, 40)) &&
        (!('tariffPerUnit' in data) || isNonNegativeNumber(data.tariffPerUnit)) &&
        (!('fixedFee' in data) || isNonNegativeNumber(data.fixedFee)) &&
        (!('extraCharges' in data) || isNonNegativeNumber(data.extraCharges)) &&
        (!('tariffSource' in data) || isBoundedString(data.tariffSource, 0, 160)) &&
        (!('tariffDate' in data) || isBoundedString(data.tariffDate, 0, 32)) &&
        (!('tieredTariffNote' in data) || isBoundedString(data.tieredTariffNote, 0, 250)) &&
        (!('currentConsumption' in data) || isNonNegativeNumber(data.currentConsumption)) &&
        (!('targetConsumption' in data) || isNonNegativeNumber(data.targetConsumption)) &&
        (!('currentSpend' in data) || isNonNegativeNumber(data.currentSpend)) &&
        (!('progressPercent' in data) || isBoundedNumber(data.progressPercent, 0, 100)) &&
        (!('notes' in data) || isBoundedString(data.notes, 0, 600)) &&
        (!('initialCapital' in data) || isNonNegativeNumber(data.initialCapital)) &&
        (!('monthlyInvestment' in data) || isNonNegativeNumber(data.monthlyInvestment)) &&
        (!('termMonths' in data) || isBoundedNumber(data.termMonths, 1, 600)) &&
        (!('nominalAnnualRate' in data) || isBoundedNumber(data.nominalAnnualRate, 0, 10000)) &&
        (!('expectedAnnualInflation' in data) || isBoundedNumber(data.expectedAnnualInflation, 0, 10000)) &&
        (!('realAnnualYield' in data) || isBoundedNumber(data.realAnnualYield, -100, 10000)) &&
        (!('projection12Months' in data) || isNonNegativeNumber(data.projection12Months)) &&
        (!('projection24Months' in data) || isNonNegativeNumber(data.projection24Months)) &&
        (!('projection36Months' in data) || isNonNegativeNumber(data.projection36Months)) &&
        (!('productType' in data) || data.productType in ['poupanca', 'cdb', 'tesouro_selic', 'tesouro_prefixado', 'tesouro_ipca', 'fundos', 'outros']) &&
        (!('compoundingFrequency' in data) || data.compoundingFrequency in ['mensal', 'diaria', 'anual']) &&
        (!('depositTiming' in data) || data.depositTiming in ['fim', 'inicio']) &&
        (!('taxMode' in data) || data.taxMode in ['automatica', 'manual', 'isento', 'bruto']) &&
        (!('manualTaxRate' in data) || isBoundedNumber(data.manualTaxRate, 0, 100)) &&
        (!('adminFeeAnnual' in data) || isBoundedNumber(data.adminFeeAnnual, 0, 100)) &&
        (!('custodyFeeAnnual' in data) || isBoundedNumber(data.custodyFeeAnnual, 0, 100)) &&
        (!('useLinkedSavings' in data) || data.useLinkedSavings is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserPublic(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserPublic(incoming(), userId) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'avatarUrl', 'authProvider', 'defaultProfileId', 'updatedAt'
        ]);
      allow delete: if false;

      // Isolated PII subcollection
      match /private/{docId} {
        allow get: if isOwner(userId) && docId == 'account' && userExists(userId);
        allow list: if false;
        allow create: if isOwner(userId) &&
          docId == 'account' &&
          isValidUserPrivate(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (userExists(userId) || existsAfter(/databases/$(database)/documents/users/$(userId)));
        allow update: if isOwner(userId) &&
          docId == 'account' &&
          userExists(userId) &&
          isValidUserPrivate(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if false;
      }

      // Family Profiles
      match /profiles/{profileId} {
        allow get: if isOwner(userId) && isValidId(profileId) && userExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(profileId) &&
          isValidFamilyProfile(incoming(), userId, profileId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (userExists(userId) || existsAfter(/databases/$(database)/documents/users/$(userId)));
        allow update: if isOwner(userId) &&
          isValidId(profileId) &&
          userExists(userId) &&
          isValidFamilyProfile(incoming(), userId, profileId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'membersCount', 'referenceRegion', 'currency', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(profileId) && userExists(userId);
      }

      // Basket Items
      match /basketItems/{itemId} {
        allow get: if isOwner(userId) && isValidId(itemId) && userExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(itemId) &&
          isValidBasketItem(incoming(), userId, itemId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId) &&
          profileExists(userId, incoming().profileId);
        allow update: if isOwner(userId) &&
          isValidId(itemId) &&
          userExists(userId) &&
          isValidBasketItem(incoming(), userId, itemId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().profileId == existing().profileId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'description', 'group', 'subcategory', 'classification', 'monthlySpend',
            'oldPrice', 'currentPrice', 'oldPriceDate', 'currentPriceDate',
            'unit', 'quantity', 'baseQuantity', 'packageSize', 'packageUnit',
            'consumptionFrequency', 'frequencyDays', 'expenseNature', 'recurrenceType',
            'accountingType', 'comparabilityBroken', 'comparabilityReason', 'dataOrigin',
            'notes', 'active', 'isArchived', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(itemId) && userExists(userId);
      }

      // Price History
      match /priceHistory/{priceId} {
        allow get: if isOwner(userId) && isValidId(priceId) && userExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(priceId) &&
          isValidPriceRecord(incoming(), userId, priceId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId) &&
          (itemExists(userId, incoming().itemId) || existsAfter(/databases/$(database)/documents/users/$(userId)/basketItems/$(incoming().itemId)));
        allow update: if isOwner(userId) &&
          isValidId(priceId) &&
          userExists(userId) &&
          isValidPriceRecord(incoming(), userId, priceId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().itemId == existing().itemId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'price', 'referenceDate', 'unit', 'source', 'origin', 'region',
            'packageSize', 'packageUnit', 'dataOrigin', 'comparabilityBroken', 'notes', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(priceId) && userExists(userId);
      }

      // Income History
      match /incomeHistory/{incomeId} {
        allow get: if isOwner(userId) && isValidId(incomeId) && userExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(incomeId) &&
          isValidIncomeRecord(incoming(), userId, incomeId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId) &&
          profileExists(userId, incoming().profileId);
        allow update: if isOwner(userId) &&
          isValidId(incomeId) &&
          userExists(userId) &&
          isValidIncomeRecord(incoming(), userId, incomeId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().profileId == existing().profileId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'referenceDate', 'nominalIncome', 'source', 'notes',
            'grossIncome', 'netIncome', 'incomeType', 'debtObligations', 'financialApplications',
            'transfers', 'availableReserve', 'workingDaysPerMonth', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(incomeId) && userExists(userId);
      }

      // Consumption Groups
      match /consumptionGroups/{groupId} {
        allow get: if isOwner(userId) && isValidId(groupId) && userExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(groupId) &&
          isValidConsumptionGroup(incoming(), userId, groupId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId);
        allow update: if isOwner(userId) &&
          isValidId(groupId) &&
          userExists(userId) &&
          isValidConsumptionGroup(incoming(), userId, groupId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'description', 'color', 'icon', 'nationalWeightIBGE', 'isCustom', 'active', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(groupId) && userExists(userId);
      }

      // Saving Strategies (Plans A, B, C)
      match /strategies/{strategyId} {
        allow get: if isOwner(userId) && isValidId(strategyId) && userExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(strategyId) &&
          isValidSavingStrategy(incoming(), userId, strategyId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId) &&
          profileExists(userId, incoming().profileId);
        allow update: if isOwner(userId) &&
          isValidId(strategyId) &&
          userExists(userId) &&
          isValidSavingStrategy(incoming(), userId, strategyId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().profileId == existing().profileId &&
          incoming().planType == existing().planType &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'applied', 'status', 'monthlySavings',
            'originalItemId', 'originalItemName', 'originalPrice', 'originalPackageSize', 'originalPackageUnit',
            'substituteName', 'substitutePrice', 'substitutePackageSize', 'substitutePackageUnit', 'monthlyQuantity',
            'qualitativeTradeoff', 'resourceName', 'resourceCategory', 'unit', 'tariffPerUnit',
            'fixedFee', 'extraCharges', 'tariffSource', 'tariffDate', 'tieredTariffNote',
            'currentConsumption', 'targetConsumption', 'currentSpend', 'progressPercent', 'notes',
            'initialCapital', 'monthlyInvestment', 'termMonths', 'nominalAnnualRate', 'expectedAnnualInflation',
            'realAnnualYield', 'projection12Months', 'projection24Months', 'projection36Months',
            'productType', 'compoundingFrequency', 'depositTiming', 'taxMode', 'manualTaxRate',
            'adminFeeAnnual', 'custodyFeeAnnual', 'useLinkedSavings', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(strategyId) && userExists(userId);
      }
    }
  }
}
